modules = ["nodejs-20", "web", "bash", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

  [[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "DB Migrate"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "All Services"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AJKMart App"

  [[workflows.workflow]]
name = "DB Migrate"
author = "agent"

  [workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd lib/db && DATABASE_URL=$(echo $DATABASE_URL | sed 's/-pooler//') pnpm push-force"

  [[workflows.workflow]]
  name = "All Services"
  mode = "parallel"
  author = "agent"

  [[workflows.workflow.tasks]]
  task = "workflow.run"
  args = "API Server"

  [[workflows.workflow.tasks]]
  task = "workflow.run"
  args = "Rider App"

  [[workflows.workflow.tasks]]
  task = "workflow.run"
  args = "Vendor App"

  [[workflows.workflow.tasks]]
  task = "workflow.run"
  args = "Admin App"

  [[workflows.workflow.tasks]]
  task = "workflow.run"
  args = "AJKMart App"

  [[workflows.workflow]]
  name = "API Server"
  author = "agent"

  [workflows.workflow.metadata]
  outputType = "webview"

  [[workflows.workflow.tasks]]
  task = "shell.exec"
  args = "cd artifacts/api-server && NODE_ENV=development node ./scripts/start-with-restart.mjs"
  waitForPort = 5000

  [[workflows.workflow]]
  name = "Rider App"
  author = "agent"

  [workflows.workflow.metadata]
  outputType = "console"

  [[workflows.workflow.tasks]]
  task = "shell.exec"
  args = "cd artifacts/rider-app && pnpm dev"
  waitForPort = 3002

  [[workflows.workflow]]
  name = "Vendor App"
  author = "agent"

  [workflows.workflow.metadata]
  outputType = "console"

  [[workflows.workflow.tasks]]
  task = "shell.exec"
  args = "cd artifacts/vendor-app && PORT=3001 pnpm dev"
  waitForPort = 3001

  [[workflows.workflow]]
  name = "Admin App"
  author = "agent"

  [workflows.workflow.metadata]
  outputType = "console"

  [[workflows.workflow.tasks]]
  task = "shell.exec"
  args = "cd artifacts/admin && PORT=3000 pnpm dev"
  waitForPort = 3000

  [[workflows.workflow]]
name = "AJKMart App"
author = "agent"

  [workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/ajkmart && PORT=8081 pnpm dev"

  [agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true
integrations = ["javascript_gemini_ai_integrations:2.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
NODE_ENV = "development"
JWT_ISSUER = "ajkmart"
VITE_API_PROXY_TARGET = "http://127.0.0.1:5000"
VAPID_PUBLIC_KEY = "BEmlZZIGCb7ZhembOoH02qzZlnhkFrYkib27NwFgtXBFDcvtHhhWC2hfZEHU4JpDbfHIRgbrCiM_f9gEEc_JHLg"
VAPID_CONTACT_EMAIL = "mailto:admin@ajkmart.app"

[userenv.development]

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 3002

[[ports]]
localPort = 3003
externalPort = 3003

[[ports]]
localPort = 5000
externalPort = 5000
